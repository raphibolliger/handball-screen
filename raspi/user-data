#cloud-config
hostname: handball-screen
manage_etc_hosts: true
timezone: Europe/Zurich
locale: de_CH.UTF-8
keyboard:
  model: pc105
  layout: ch

users:
  - name: handball
    groups: users,adm,dialout,audio,netdev,video,plugdev,cdrom,games,input,gpio,spi,i2c,render,sudo
    shell: /bin/bash
    lock_passwd: false
    passwd: __PASSWORD_HASH__
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys: __SSH_AUTHORIZED_KEYS__

ssh_pwauth: true

write_files:
  - path: /usr/local/bin/handball-screen-kiosk
    permissions: "0755"
    content: |
      #!/bin/sh
      SCREEN_URL="https://thankful-forest-081355703.5.azurestaticapps.net/"
      NETWORK_WAIT_SECONDS=120
      CHROMIUM_PROFILE="$HOME/.config/chromium/Default"

      has_offline_copy() {
        [ -d "$CHROMIUM_PROFILE/Service Worker" ]
      }

      wait_for_screen_url() {
        waited=0
        until curl --silent --head --fail --max-time 5 "$SCREEN_URL" >/dev/null 2>&1; do
          [ "$waited" -ge "$NETWORK_WAIT_SECONDS" ] && return
          sleep 5
          waited=$((waited + 5))
        done
      }

      mark_last_session_clean() {
        [ -f "$CHROMIUM_PROFILE/Preferences" ] || return
        sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[^"]*"/"exit_type":"Normal"/' "$CHROMIUM_PROFILE/Preferences"
      }

      has_offline_copy || wait_for_screen_url
      mark_last_session_clean
      exec chromium "$SCREEN_URL" \
        --kiosk \
        --noerrdialogs \
        --disable-infobars \
        --no-first-run \
        --start-maximized \
        --hide-crash-restore-bubble \
        --disable-features=Translate \
        --password-store=basic

  - path: /home/handball/.config/labwc/autostart
    owner: handball:handball
    permissions: "0644"
    defer: true
    content: |
      /usr/bin/lwrespawn /usr/local/bin/handball-screen-kiosk &

  - path: /etc/systemd/system/handball-screen-reboot.service
    content: |
      [Unit]
      Description=Nightly reboot of the handball screen

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/systemctl reboot

  - path: /etc/systemd/system/handball-screen-reboot.timer
    content: |
      [Unit]
      Description=Nightly reboot of the handball screen

      [Timer]
      OnCalendar=*-*-* 04:00:00

      [Install]
      WantedBy=timers.target

runcmd:
  - [chown, -R, "handball:handball", /home/handball/.config]
  - [raspi-config, nonint, do_ssh, "0"]
  - [raspi-config, nonint, do_boot_behaviour, B4]
  - [raspi-config, nonint, do_blanking, "1"]
  - [systemctl, enable, handball-screen-reboot.timer]

power_state:
  mode: reboot
  message: Handball screen setup finished
  condition: true
